<h1>Login Page</h1>

@model Todo.MvcUI.Models.UserOL

<div class="row">
    <div class="col-md-4">
        <section>
            <form method="post" asp-action="DoLogin">
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="UserName" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="UserName" class="form-label">Email</label>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Password" class="form-label">Password</label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input type="submit" value="Login" class="btn btn-primary" /> 
                    <a asp-action="Register" class="link-info mb-2">No Account? Register</a>
                </div>
            </form>
        </section>
    </div>
</div>